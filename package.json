{
	"name": "coverfold",
	"version": "1.0.0",
	"private": true,
	"description": "Coverfold: photo and video album gallery for WordPress, with a block editor block and an Elementor widget.",
	"license": "GPL-3.0-or-later",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"lint": "npm run lint:js && npm run lint:css",
		"lint:js": "wp-scripts lint-js assets/js blocks",
		"lint:css": "wp-scripts lint-style \"assets/css/**/*.css\"",
		"format": "wp-scripts format assets/js assets/css blocks",
		"vendor:foldbox": "node bin/vendor-foldbox.mjs",
		"vendor:foldbox:check": "node bin/vendor-foldbox.mjs --check"
	},
	"devDependencies": {
		"@wordpress/scripts": "^37.2.0"
	},
	"dependencies": {
		"foldbox": "^1.3.1"
	}
}
